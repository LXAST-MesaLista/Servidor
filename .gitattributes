# Los scripts se ejecutan en Ubuntu: siempre con saltos de línea LF
*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.sql     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf

# Binarios: nunca se tocan los saltos de línea
*.pdf  binary
*.png  binary
